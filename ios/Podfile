require 'json'

# Resolve paths correctly for Expo and React Native dependencies
expo_path = `node --print "require.resolve('expo/package.json')"`&.strip
rn_path = `node --print "require.resolve('react-native/package.json')"`&.strip

raise "Expo package not found" if expo_path.empty?
raise "React Native package not found" if rn_path.empty?

require File.join(File.dirname(expo_path), "scripts/autolinking")
require File.join(File.dirname(rn_path), "scripts/react_native_pods")

# Load Podfile properties
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

# Environment variables
ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] = podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']

platform :ios, '17.0'

install! 'cocoapods', :deterministic_uuids => false

prepare_react_native_project!

target 'ToBeWisePro' do
  use_expo_modules!

  # Explicitly define the path to ExpoModulesCore
  pod 'ExpoModulesCore', :path => '../node_modules/expo-modules-core'

  config = use_native_modules!

  # Ensure dynamic linking is used for some Expo modules
  use_frameworks! :linkage => :dynamic
  use_modular_headers!

  # Disable Hermes explicitly
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false, # Hermes disabled
    :fabric_enabled => podfile_properties['newArchEnabled'] == 'true',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      end
    end

    # Workaround for '-G' clang issue in BoringSSL-GRPC
    installer.pods_project.targets.each do |target|
      if target.name == 'BoringSSL-GRPC'
        target.source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS'].split
            flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
            file.settings['COMPILER_FLAGS'] = flags.join(' ')
          end
        end
      end
    end

    # Ensure gRPC-Core works with C++17
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end

  post_integrate do |installer|
    begin
      expo_patch_react_imports!(installer)
    rescue => e
      Pod::UI.warn e
    end
  end
end
